# Telegram Credentials
# 1. Go to https://my.telegram.org
# 2. Sign-in with your Telegram number
# 3. Click on 'API Development Tools'
# 4. Create new app
API_ID=12345678
API_HASH=your_api_hash_here

# 1. Go to @botfather bot
# 2. Create new bot
BOT_TOKEN=your_bot_token_here

# 1. Go to @Userinfokbot bot
# 2. Send a message to bot
ADMIN_USER_ID=123456789

# 1. Add your bot to group
# 2. Promot bot to admin
# 3. Send a message to group
# 4. open https://api.telegram.org/bot<BOT-TOKEN>/getUpdates
# Notic: Replace <BOT-TOKEN> with yours.
GROUP_CHAT_ID=-1000000000000

# Directory Paths
STATE_FILE=/mnt/backup/state.json
PROJECTS_DIR=/mnt/backup/projects/

# Session File (optional, defaults to backup_session)
# SESSION_FILE=backup_session

# Log File (optional, logs to stderr only if unset)
# LOG_FILE=/mnt/backup/backup.log

# Backup Settings
MAX_FILE_SIZE_GB=1.9
RETENTION_LIMIT=10
